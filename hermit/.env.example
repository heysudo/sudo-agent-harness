# Copy to /etc/hermit/hermit.env on the device (mode 0600, owned root:hermit).
# NEVER commit a filled-in copy of this file.
#
# systemd reads this via EnvironmentFile= in hermit.service.

# --- required ---------------------------------------------------------------
# Cerebras: the LLM. Without this the daemon refuses to start.
CEREBRAS_API_KEY=

# --- tools (each optional; the matching tool reports an error to the model if unset)
# Parallel: web_search. Turbo mode, ~200ms, $1 per 1000 requests.
PARALLEL_API_KEY=
# Firecrawl: fetch_page.
FIRECRAWL_API_KEY=

# --- voice ------------------------------------------------------------------
# Sarvam: the default STT (saaras:v3-realtime) AND TTS (bulbul:v3) provider,
# with per-turn language detection across 11 Indian languages + English.
SARVAM_API_KEY=
# Alternative providers — set the ones matching stt.provider / tts.provider
# in hermit.toml if you switch away from Sarvam.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
# Wake word (only for the Porcupine fallback engine; the bundled "Hey Sudo"
# ONNX model needs no key). Free tier at console.picovoice.ai.
PICOVOICE_ACCESS_KEY=

# --- music (all three required for Spotify; Premium account needed) ----------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- gateway security ---------------------------------------------------------
# Bearer token for the WebSocket gateway. REQUIRED if server.ws_bind is not
# loopback (the daemon refuses to start without it); recommended even on
# loopback. Clients authenticate with `Authorization: Bearer <token>` or a
# first message of `/auth <token>`. Generate one:  openssl rand -hex 32
#HERMIT_WS_TOKEN=

# --- optional ---------------------------------------------------------------
# Override where the Porcupine shared library and model live.
#PV_PORCUPINE_LIB=/opt/hermit/lib/libpv_porcupine.so
#PV_PORCUPINE_MODEL=/opt/hermit/lib/porcupine_params.pv
# Log filter, e.g. "info,hermit=debug"
#HERMIT_LOG=info
