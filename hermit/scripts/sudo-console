#!/usr/bin/env bash
# sudo-console — attach the live TUI to a HERMIT device from the dev machine.
set -euo pipefail
HOST="${1:-<pi-host>}"
TERM_NAME="${TERM:-xterm-256color}"
[[ "$TERM_NAME" == "dumb" || "$TERM_NAME" == "unknown" ]] && TERM_NAME="xterm-256color"
exec ssh -t "$HOST" "TERM=$(printf '%q' "$TERM_NAME") exec sudo-console"
